<?xml version="1.0"?>
<robot name="robo_robot" xmlns:xacro="https://www.ros.org/wiki/xacro">

<xacro:include filename ="$(find pathbot_description)/urdf/robot.xacro"/>

<!-- Skid-steer scrub correction for the DiffDrive odometry. The four fixed
     wheels scrub sideways when turning, so the effective track is wider than
     the geometric 2*s4 = 0.70 m. Measured against Gazebo ground truth: odom
     over-reported yaw by ~2.1x at 1.0, then under-reported by 9% at 2.10.
     Converged value below; see the calibration procedure in COMMANDS.md. -->
<xacro:property name="track_correction" value="1.91"/>

<!-- <gazebo>
    <model>
        <canonical_link>body_link</canonical_link>
    </model>
</gazebo> -->

<gazebo reference = "body_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <material>Gazebo/Red</material>
</gazebo>

<gazebo reference = "wheel1_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference = "wheel2_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference = "wheel3_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference = "wheel4_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Yellow</material>
</gazebo>

<!-- <gazebo reference = "caster_link">
    <mu1>0.00002</mu1>
    <mu2>0.00002</mu2>
    <material>Gazebo/Blue</material>
</gazebo> -->

<gazebo>
    <plugin filename = "libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">

        <!-- +y is LEFT (REP-103). wheel2/wheel4 sit at y=+s4, wheel1/wheel3 at
             y=-s4. Getting this backwards inverts the sign of odometry yaw and
             destroys SLAM on every turn. -->
        <left_joint>wheel2_joint</left_joint>
        <left_joint>wheel4_joint</left_joint>

        <right_joint>wheel1_joint</right_joint>
        <right_joint>wheel3_joint</right_joint>

        <!-- 4-wheel skid-steer: the wheels scrub sideways when turning, so the
             effective track is wider than the geometric 2*s4. Calibrated
             against Gazebo ground truth - see COMMANDS.md. -->
        <wheel_separation>${2*s4*track_correction}</wheel_separation>
        <wheel_radius>${radius}</wheel_radius>

        <topic>/cmd_vel</topic>
        <tf_topic>/tf</tf_topic>
        <odom_topic>/odom</odom_topic>
        <!-- Required. Without it the odom frame becomes "robo_robot/odom",
             which breaks the odom->body_footprint TF chain and makes
             slam_toolbox drop every scan ("queue is full"). -->
        <frame_id>odom</frame_id>
        <child_frame_id>body_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="libgz-sim-joint-state-publisher-system.so" name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>wheel1_joint</joint_name>
        <joint_name>wheel2_joint</joint_name>
        <joint_name>wheel3_joint</joint_name>
        <joint_name>wheel4_joint</joint_name>
    </plugin>   
</gazebo>
<!-- 
sensor is world pulggin not a robot pluggin
<gazebo>
    <plugin filename="libgz-sim-sensors-system.so"
            name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>
</gazebo> -->


<!-- LiDAR sensor -->
<gazebo reference="lidar_link">
<!-- get to gpu lidar if it nromlly starts to work also cpu lidar that is normal lidar is not supportd in ros gazebo 8-->
    <sensor name="gpu_lidar" type="gpu_lidar">
        <!-- <ray>
            <collision>
                <ignore_entity>robo_robot</ignore_entity>
            </collision>
        </ray> -->
        <!-- as it is directely attached to lidar link -->
    <pose>0 0 0 0 0 0</pose>

    <topic>scan</topic>

    <update_rate>10</update_rate>

    <lidar>
        <scan>
            <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
            </horizontal>
        </scan>

        <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
        </range>

        <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
        </noise>
    </lidar>

    <always_on>true</always_on>
    <!-- only for testing turning it of -->
    <visualize>true</visualize> 

    </sensor>
</gazebo>


</robot>
